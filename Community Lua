-- Toggle factory
local function createToggle(labelText, yPos, onCallback, offCallback)
    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, -24, 0, 36)
    row.Position = UDim2.fromOffset(12, yPos)
    row.BackgroundTransparency = 1
    row.Parent = panel

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -70, 1, 0)
    label.BackgroundTransparency = 1
    label.Text = labelText
    label.TextColor3 = THEME.Text
    label.Font = Enum.Font.GothamMedium
    label.TextSize = 13
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = row

    local switch = Instance.new("TextButton")
    switch.Size = UDim2.fromOffset(56, 26)
    switch.Position = UDim2.new(1, -56, 0.5, -13)
    switch.BackgroundColor3 = THEME.Off
    switch.AutoButtonColor = false
    switch.Text = ""
    switch.Parent = row
    
    local sCorner = Instance.new("UICorner")
    sCorner.CornerRadius = UDim.new(1, 0)
    sCorner.Parent = switch
    
    local ball = Instance.new("Frame")
    ball.Size = UDim2.fromOffset(20, 20)
    ball.Position = UDim2.fromOffset(3, 3)
    ball.BackgroundColor3 = THEME.Ball
    ball.BorderSizePixel = 0
    ball.Parent = switch
    
    local bCorner = Instance.new("UICorner")
    bCorner.CornerRadius = UDim.new(1, 0)
    bCorner.Parent = ball
    
    local state = false
    local function setState(s)
        state = s
        local goalPos = s and UDim2.fromOffset(33, 3) or UDim2.fromOffset(3, 3)
        local goalColor = s and THEME.On or THEME.Off
        TweenService:Create(ball, TweenInfo.new(0.18, Enum.EasingStyle.Quad), {Position = goalPos}):Play()
        TweenService:Create(switch, TweenInfo.new(0.18, Enum.EasingStyle.Quad), {BackgroundColor3 = goalColor}):Play()
        if s then onCallback() else offCallback() end
    end
    switch.MouseButton1Click:Connect(function() setState(not state) end)
    
    -- Mobile touch support
    switch.TouchTap:Connect(function() setState(not state) end)
    
    return setState
end

